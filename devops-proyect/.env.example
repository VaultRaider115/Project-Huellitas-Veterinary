# Copie este archivo a devops-proyect/.env y genere secretos reales.
# .env nunca debe versionarse.
#
# Generación de secretos (ejecute tres veces y use una salida distinta en cada uno):
#   openssl rand -hex 32

SPRING_DATASOURCE_URL=jdbc:mariadb://localhost:3306/huellitas_db
SPRING_DATASOURCE_USERNAME=huellitas
SPRING_DATASOURCE_PASSWORD=REEMPLACE_ESTA_CLAVE

# Claves de 64 caracteres hexadecimales.
AES_SECRET=REEMPLACE_CON_64_HEX
HMAC_SECRET=REEMPLACE_CON_64_HEX
JWT_SECRET=REEMPLACE_CON_64_HEX

TURNSTILE_ENABLED=false
TURNSTILE_SECRET=
TURNSTILE_EXPECTED_HOSTNAMES=

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_SECURITY_ATTEMPTS_MAX=5
APP_SECURITY_ATTEMPTS_LOCKOUT_MINUTES=15
